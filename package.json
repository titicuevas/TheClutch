{
  "name": "theclutch",
  "private": true,
  "engines": { "node": ">=20.9.0" },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "test": "pnpm --filter @theclutch/engine test",
    "test:e2e": "pnpm --filter @theclutch/web test:e2e",
    "sim": "pnpm --filter @theclutch/engine sim",
    "dev": "pnpm --filter @theclutch/web dev",
    "start": "pnpm --filter @theclutch/web start",
    "build": "pnpm --filter @theclutch/web build"
  }
}
